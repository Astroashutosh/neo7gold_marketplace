# Base path for dev subpath (e.g. /neos7gold_marketplace). Leave empty in production on main domain.
NEXT_PUBLIC_BASE_PATH=/neos7gold_marketplace

# Backend API base URL used by the storefront.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of the Neos7 Gold dashboard (login is served at /login/).
# Do not include a trailing slash.
NEXT_PUBLIC_DASHBOARD_BASE_URL=http://localhost:3001/neos7gold_dashboard
